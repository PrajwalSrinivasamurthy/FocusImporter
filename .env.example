# Copy this file to .env.local and fill in the values

# PostgreSQL (used by the postgres-db container)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=ttu_online_dev

# App's connection string to PostgreSQL.
# Use "localhost" when running the app outside Docker (postgres-db's port
# 5432 is published to the host). Use "postgres-db" as the host instead if
# the app is also run via docker-compose (same Docker network).
DATABASE_URL=postgresql://user:password@localhost:5432/ttu_online_dev

# JWT signing secret — must be at least 32 characters
JWT_SECRET=

# Twilio (used by the uptime-check cron job to send SMS alerts)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Comma-separated to notify multiple people, e.g. +18062244674,+18065551234
TWILIO_TO_NUMBER=

# Public URL the health-check cron job pings to determine if the app is up
# Deployed behind nginx at /focusimporter:
HEALTH_CHECK_URL=http://localhost:3007/focusimporter/api/health

# TtuOnline2026
